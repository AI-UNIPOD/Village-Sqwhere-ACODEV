# Local development settings. Never commit real secrets: .env files are git-ignored.
#
# API (apps/api) reads these from the environment. The defaults in apps/api/app/config.py
# already match the values below, so you only need to set them to override.
DATABASE_URL=postgresql://village:village@localhost:5432/village_sqwhere
CORS_ORIGINS=http://localhost:3000

# Web (apps/web): copy to apps/web/.env.local to override.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security: JWT configuration for signing and verifying tokens
JWT_SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# OAuth Providers (GitHub & Bitbucket)
# -----------------------------------------------------------------------------
# In local development without these variables, the API automatically operates
# in simulation/mock mode so we can develop and run tests completely offline
# without needing live third-party developer credentials.
#
# We would have to provide these when testing live sign-in or deploying to production:
# 
# For GitHub:
# Create an OAuth App at https://github.com/settings/developers:
# - Homepage URL: http://localhost:3000 (or your production domain)
# - Authorization callback URL: http://localhost:8000/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# For Bitbucket (Optional):
BITBUCKET_CLIENT_ID=your_bitbucket_client_id_here
BITBUCKET_CLIENT_SECRET=your_bitbucket_client_secret_here