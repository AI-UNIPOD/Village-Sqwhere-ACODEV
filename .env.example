# Local development settings. Never commit real secrets: .env files are git-ignored.
#
# API (apps/api) reads these from the environment or a root .env file. The defaults in
# apps/api/app/config.py match the values below, except JWT_SECRET_KEY, which you must set.
DATABASE_URL=postgresql://village:village@localhost:5432/village_sqwhere
CORS_ORIGINS=http://localhost:3000

# Web (apps/web): copy to apps/web/.env.local to override.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security: the key that signs sign-in tokens. Required: the API will not start without it.
# Use a random value of at least 32 characters, different on every server. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# OAuth providers
# -----------------------------------------------------------------------------
# Sign-in always goes through GitHub; there is no offline or mock sign-in. Without
# these two values, sign-in returns PROVIDER_NOT_CONFIGURED. Tests do not need them.
#
# Create your own OAuth App at https://github.com/settings/developers:
# - Homepage URL: http://localhost:3000 (or your production domain)
# - Authorization callback URL: http://localhost:8000/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional token for GitHub repository analysis. Public repositories work without one,
# but a token raises the API rate limit.
GITHUB_API_TOKEN=

# AI verification. Model names are supplied by the deployment environment.
GROQ_API_KEY=
GROQ_CODEBASE_MODEL=
GROQ_STT_MODEL=whisper-large-v3
GROQ_GUARD_MODEL=
GROQ_INTERVIEW_MODEL=
GROQ_EVALUATION_MODEL=
GEMINI_API_KEY=
GEMINI_CODEBASE_MODEL=
VERIFICATION_MAX_ANALYSIS_ATTEMPTS=3
VERIFICATION_WORKER_INTERVAL_SECONDS=5

# Bitbucket sign-in is not built yet. These are not used.
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
