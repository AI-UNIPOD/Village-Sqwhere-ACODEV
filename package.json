{
  "name": "village-sqwhere",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "test:web": "pnpm --filter web test",
    "dev:api": "uv run --directory apps/api fastapi dev app/main.py",
    "test:api": "uv run --directory apps/api pytest",
    "lint:api": "uv run --directory apps/api ruff check . && uv run --directory apps/api ruff format --check .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  }
}
