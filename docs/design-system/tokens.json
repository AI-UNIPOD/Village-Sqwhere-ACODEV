{
  "$description": "Village Sqwhere design tokens, version 1. tokens.css carries the same values as CSS variables; change both together.",
  "palette": {
    "ink": { "$type": "color", "$value": "#0B0C10", "$description": "Dark base, text on Paper" },
    "paper": { "$type": "color", "$value": "#FFFFFF", "$description": "Light base, text on Ink" },
    "laterite": { "$type": "color", "$value": "#F0601F", "$description": "Brand and action. Shapes only on Paper (3.28:1); text OK on Ink (5.96:1)" },
    "laterite-700": { "$type": "color", "$value": "#B23F0C", "$description": "Orange text, links and the logo on Paper (5.82:1)" },
    "lagoon": { "$type": "color", "$value": "#3DBFDB", "$description": "AI colour on Ink (9.00:1). Never on Paper" },
    "lagoon-700": { "$type": "color", "$value": "#0C6680", "$description": "AI colour on Paper (6.51:1)" }
  },
  "theme": {
    "light": {
      "bg": "#FFFFFF", "surface": "#FFFFFF", "surface-raised": "#FFFFFF", "surface-sunken": "#F4F4F2",
      "text": "#0B0C10", "text-muted": "#5B5E68", "line": "#E0E0DC", "line-strong": "#878A93",
      "action": "#F0601F", "action-hover": "#DD581D", "action-active": "#D3541B", "on-action": "#0B0C10",
      "link": "#B23F0C", "logo": "#B23F0C", "ai": "#0C6680", "ai-tint": "#E8F7FB",
      "success": "#157A3E", "success-fill": "#34C26E", "success-tint": "#E7F8EE",
      "warning": "#8F5D00", "warning-fill": "#FFC53D", "warning-tint": "#FFF8E8",
      "error": "#B4163C", "error-fill": "#FF5C7A", "error-tint": "#FFEBEF",
      "info": "#0B0C10", "info-tint": "#F4F4F2",
      "focus": "#0B0C10", "scrim": "rgba(11, 12, 16, 0.55)",
      "shadow-1": "0 1px 2px rgba(11, 12, 16, 0.06), 0 2px 6px rgba(11, 12, 16, 0.06)",
      "shadow-2": "0 1px 3px rgba(11, 12, 16, 0.06), 0 6px 20px rgba(11, 12, 16, 0.1)",
      "shadow-3": "0 20px 56px rgba(11, 12, 16, 0.22)",
      "shadow-float": "0 1px 2px rgba(11, 12, 16, 0.08), 0 4px 12px rgba(11, 12, 16, 0.08)"
    },
    "dark": {
      "bg": "#0B0C10", "surface": "#17191F", "surface-raised": "#20232B", "surface-sunken": "#17191F",
      "text": "#FFFFFF", "text-muted": "#A3A6B0", "line": "#262934", "line-strong": "#666A79",
      "action": "#F0601F", "action-hover": "#F2733A", "action-active": "#DD581D", "on-action": "#0B0C10",
      "link": "#F0601F", "logo": "#F0601F", "ai": "#3DBFDB", "ai-tint": "#132930",
      "success": "#34C26E", "success-fill": "#34C26E", "success-tint": "#12291F",
      "warning": "#FFC53D", "warning-fill": "#FFC53D", "warning-tint": "#322A17",
      "error": "#FF5C7A", "error-fill": "#FF5C7A", "error-tint": "#321921",
      "info": "#FFFFFF", "info-tint": "#17191F",
      "focus": "#FFFFFF", "scrim": "rgba(0, 0, 0, 0.62)",
      "shadow-1": "0 1px 2px rgba(0, 0, 0, 0.4)",
      "shadow-2": "0 8px 24px rgba(0, 0, 0, 0.5)",
      "shadow-3": "0 24px 64px rgba(0, 0, 0, 0.6)",
      "shadow-float": "0 1px 2px rgba(0, 0, 0, 0.5), 0 4px 12px rgba(0, 0, 0, 0.4)"
    }
  },
  "font": {
    "display": { "family": "Unbounded", "weights": [500, 700, 800], "use": "Our own headlines, scores and the product name only. Never people's names or user text" },
    "ui": { "family": "Onest", "weights": [400, 500, 600, 700], "use": "Interface and body text, all names and anything users type" },
    "mono": { "family": "JetBrains Mono", "weights": [400, 600], "use": "Code, commit stats and Cmd+K shortcuts only" }
  },
  "type": {
    "$description": "size/lineHeight in rem. 'desktop' applies from 900px, 'tablet' from 768px and 'phone' below 600px; steps without them stay the same.",
    "display-xl": { "font": "display", "weight": 800, "size": "2.25rem", "lineHeight": "2.5rem", "letterSpacing": "-0.02em", "desktop": { "size": "3.5rem", "lineHeight": "3.75rem" }, "use": "Landing hero, once per page" },
    "display-l": { "font": "display", "weight": 800, "size": "1.75rem", "lineHeight": "2rem", "letterSpacing": "-0.02em", "desktop": { "size": "2.5rem", "lineHeight": "2.75rem" }, "use": "Page titles" },
    "display-m": { "font": "display", "weight": 700, "size": "1.375rem", "lineHeight": "1.75rem", "letterSpacing": "-0.01em", "desktop": { "size": "1.75rem", "lineHeight": "2rem" }, "use": "Section headings, empty-state titles" },
    "score": { "font": "display", "weight": 800, "size": "2rem", "lineHeight": "1", "tabularNums": true, "desktop": { "size": "2.5rem" }, "use": "Match scores and big numbers" },
    "title": { "font": "ui", "weight": 600, "size": "1.125rem", "lineHeight": "1.5rem", "desktop": { "size": "1.25rem", "lineHeight": "1.75rem" }, "use": "Card and modal titles, names on profiles" },
    "body-l": { "font": "ui", "weight": 400, "size": "1rem", "lineHeight": "1.5rem", "desktop": { "size": "1.125rem", "lineHeight": "1.75rem" }, "use": "Lead paragraph under a page title" },
    "body": { "font": "ui", "weight": 400, "size": "1rem", "lineHeight": "1.5rem", "use": "Default reading text" },
    "body-s": { "font": "ui", "weight": 400, "size": "0.875rem", "lineHeight": "1.25rem", "use": "Meta lines, helper text, table cells. Smallest size for sentences" },
    "label": { "font": "ui", "weight": 600, "size": "0.9375rem", "lineHeight": "1.25rem", "use": "Buttons, tabs, field labels" },
    "caption": { "font": "ui", "weight": 500, "size": "0.75rem", "lineHeight": "1rem", "letterSpacing": "0.01em", "use": "Badges, counts, timestamps. Never full sentences" },
    "code": { "font": "mono", "weight": 400, "size": "0.875rem", "lineHeight": "1.25rem", "use": "Code and commit stats" },
    "hero": { "font": "display", "weight": 800, "size": "min(clamp(2.25rem, 1.2rem + 2.6vw, 5rem), calc(100cqi / var(--hero-measure)))", "measure": "12.1", "lineHeight": "1.1", "letterSpacing": "-0.02em", "phone": { "size": "min(2.25rem, calc(100cqi / var(--hero-measure)))", "measure": "8.9", "lineHeight": "1.12", "use": "Below 600px the size follows the width of its column, so French never spills" }, "use": "Landing hero headline, in place of display-xl. Needs a container-type: inline-size parent. The measure is the longest line in ems: two lines from 600px, three below; the hero layout reads it to size the square to the text" },
    "hero-sub": { "font": "ui", "weight": 400, "size": "clamp(1rem, 0.85rem + 0.35vw, 1.5rem)", "lineHeight": "1.55", "use": "Sentence under the landing hero headline" },
    "wordmark": { "font": "display", "weight": 700, "size": "15px", "lineHeight": "1", "tablet": { "size": "17px" }, "use": "The words Village Sqwhere next to the logo" },
    "wordmark-nav": { "font": "display", "weight": 700, "size": "15px", "lineHeight": "1", "tablet": { "size": "clamp(16px, 1.3vw, 20px)" }, "use": "The wordmark in the page header, from 768px it grows with the screen" },
    "nav-link": { "font": "ui", "weight": 600, "size": "clamp(0.9375rem, 0.8rem + 0.2vw, 1.0625rem)", "lineHeight": "1.25rem", "use": "Links in the page header" },
    "section": { "font": "display", "weight": 800, "size": "2.25rem", "lineHeight": "2.5rem", "letterSpacing": "-0.02em", "desktop": { "size": "2.5rem", "lineHeight": "2.875rem" }, "use": "Headings of the landing sections below the hero" },
    "step-title": { "font": "display", "weight": 700, "size": "1.25rem", "lineHeight": "1.75rem", "use": "Titles of the numbered steps" },
    "mono-label": { "font": "mono", "weight": 600, "size": "0.75rem", "lineHeight": "1", "letterSpacing": "0.04em", "use": "Two-letter buttons (EN, FR) and step numbers" },
    "mono-row": { "font": "mono", "weight": 400, "size": "0.75rem", "lineHeight": "1.5rem", "use": "Numbers and times in a list row" }
  },
  "hero": {
    "$description": "Spacing and buttons of the landing hero. They grow with the screen.",
    "button-height": "clamp(44px, 14px + 2.4vw, 54px)",
    "button-pad": "clamp(20px, 1.7vw, 28px)",
    "button-font": "clamp(0.9375rem, 0.8rem + 0.25vw, 1.0625rem)",
    "sub-gap": "clamp(24px, 1.9vw, 32px)",
    "cta-gap": "clamp(12px, 1vw, 16px)",
    "cta-top": "clamp(40px, 3.2vw, 52px)",
    "min-height": "600px",
    "frame-share": "72%",
    "frame-max": "1760px"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px" },
  "layout": {
    "breakpoints": { "tablet": "768px", "type-desktop": "900px", "desktop": "1100px" },
    "gutter": { "phone": "space-4", "tablet": "space-6", "desktop": "space-8" },
    "pad-card": { "phone": "space-4", "tablet": "space-6" },
    "grid-gap": { "phone": "space-5", "tablet": "space-6" },
    "section": { "phone": "space-12", "desktop": "space-16" },
    "content-max": "1180px",
    "min-width": "360px",
    "tap-min": "44px",
    "float-size": "36px",
    "float-top": { "phone": "10px", "tablet": "18px" },
    "float-gutter": { "phone": "64px", "tablet": "68px" },
    "section-block": { "phone": "56px", "tablet": "space-20" },
    "nav-height": { "phone": "56px", "tablet": "72px" },
    "nav-gap": { "phone": "space-3", "tablet": "clamp(20px, 2vw, 32px)" },
    "nav-logo-size": { "phone": "24px", "tablet": "clamp(28px, 2.4vw, 36px)" },
    "pill-height": { "phone": "48px", "tablet": "56px" },
    "pill-top": { "phone": "space-2", "tablet": "space-3" },
    "blur-bar": "12px",
    "brand-gap": "10px",
    "underline-offset": "5px",
    "icon-toggle": "18px",
    "icon-play": "14px",
    "tour-button-gap": "28px"
  },
  "radius": { "xs": "4px", "s": "8px", "m": "12px", "l": "16px", "full": "999px" },
  "elevation": {
    "0": { "use": "Page", "surface": "bg" },
    "1": { "use": "Cards, fields", "surface": "surface", "border": "line" },
    "2": { "use": "Menus, toasts, popovers", "surface": "surface-raised", "shadow": "shadow-2" },
    "3": { "use": "Dialogs, Cmd+K palette, over the scrim", "surface": "surface-raised", "shadow": "shadow-3" }
  },
  "focus": { "outline": "2px solid var(--focus)", "offset": "2px", "when": ":focus-visible only" },
  "motion": {
    "easing": { "out": "cubic-bezier(0.23, 1, 0.32, 1)", "drawer": "cubic-bezier(0.32, 0.72, 0, 1)", "strong": "cubic-bezier(0.16, 1, 0.3, 1)", "linear": "linear" },
    "duration": {
      "instant": { "value": "0ms", "use": "Cmd+K, keyboard shortcuts, list navigation" },
      "press": { "value": "160ms", "use": "Press, toggle, hover; buttons scale to 0.97" },
      "menu": { "in": "180ms", "out": "120ms", "easing": "out", "use": "Menus, tooltips, popovers; grow from their trigger" },
      "modal": { "in": "220ms", "out": "150ms", "easing": "out", "use": "Dialogs; grow from the centre" },
      "drawer": { "in": "400ms", "out": "260ms", "easing": "drawer", "use": "Drawers; slide from their edge, no fade" },
      "sheet": { "in": "500ms", "out": "320ms", "easing": "drawer", "use": "Bottom sheets; no overshoot" },
      "moment": { "value": "520ms", "easing": "strong", "use": "Once per screen: a match lands, a Green Tick is earned" },
      "reveal": { "value": "400ms", "reduced": "200ms", "easing": "out", "use": "Content rising into place once as it scrolls into view; a fade only with reduced motion" },
      "stagger": { "value": "80ms", "use": "Delay between items arriving one after another in a row or list" },
      "icon": { "value": "320ms", "easing": "out", "use": "An icon turning into another, such as the sun and moon on the theme button" },
      "drift": { "value": "2s", "easing": "linear", "use": "Landing hero background words scroll right to left forever: space-8 every 2s, about 16px a second, looping without a seam" },
      "spinner-delay": { "value": "400ms", "use": "Show waiting indicators only after this" }
    },
    "reduced": "Keep fades and colour changes, remove movement. Never remove feedback."
  },
  "icon": { "grid": "24px", "stroke": "1.75px", "sizes": { "small": "16px", "default": "20px", "large": "24px" }, "set": "Lucide" },
  "avatar": { "sizes": { "list": "24px", "stack": "32px", "card": "44px", "profile": "64px" } },
  "match-score": {
    "strong": { "from": 80, "color": "success" },
    "possible": { "from": 60, "color": "text" },
    "weak": { "from": 40, "color": "warning" },
    "poor": { "from": 0, "color": "error" }
  },
  "logo": {
    "name": "Palaver tree, V",
    "files": {
      "on-paper": "logo/palaver-tree-v_on-paper.svg",
      "on-ink": "logo/palaver-tree-v_on-ink.svg",
      "for-paper-surfaces": "logo/palaver-tree-v_laterite-700.svg",
      "for-ink-surfaces": "logo/palaver-tree-v_laterite.svg",
      "browser-tab": "logo/palaver-tree-v_laterite.svg"
    },
    "color": { "light": "laterite-700", "dark": "laterite" },
    "clear-space": "25% of the mark's height on every side",
    "min-size": "16px"
  }
}
